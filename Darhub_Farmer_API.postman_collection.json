{
	"info": {
		"_postman_id": "8d3e2b1a-9f4c-4e89-a1b2-c3d4e5f6a7b8",
		"name": "Darhub Farmer App API Collection",
		"description": "Comprehensive Postman collection for Darhub Farmer App. Includes authentication, profile management, crops discovery, order creation, order listing, status tabs, detailed order tracking, and order actions.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5678",
			"type": "string"
		},
		{
			"key": "farmerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		},
		{
			"key": "bookingId",
			"value": "",
			"type": "string"
		},
		{
			"key": "cropTypeId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Farmer Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('farmerToken', jsonData.token);",
									"}",
									"if (jsonData.user_id) {",
									"    pm.collectionVariables.set('userId', jsonData.user_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "first_name", "value": "Ramesh", "type": "text" },
								{ "key": "last_name", "value": "Patel", "type": "text" },
								{ "key": "email", "value": "ramesh.farmer@example.com", "type": "text" },
								{ "key": "password", "value": "Password@123", "type": "text" },
								{ "key": "mobile_number", "value": "9876543210", "type": "text" },
								{ "key": "dob", "value": "1985-05-15", "type": "text" },
								{ "key": "isMobileVerify", "value": "true", "type": "text" },
								{ "key": "isverifyEmail", "value": "true", "type": "text" },
								{
									"key": "address",
									"value": "[{\"state\": 1, \"district\": 1, \"block\": 1, \"village\": \"Sonpur\", \"lane1\": \"North Road\", \"pincode\": \"800001\", \"is_primary\": true}]",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/user/farmer-registration",
							"host": ["{{baseUrl}}"],
							"path": ["api", "user", "farmer-registration"]
						}
					}
				},
				{
					"name": "1.2 Farmer Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('farmerToken', jsonData.token);",
									"}",
									"if (jsonData.refreshToken) {",
									"    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
									"}",
									"if (jsonData.user && jsonData.user.id) {",
									"    pm.collectionVariables.set('userId', jsonData.user.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobile_number\": \"9876543210\",\n    \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "1.3 Verify Token (Me API)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/user/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "user", "me"]
						}
					}
				},
				{
					"name": "1.4 Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('farmerToken', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{refreshToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/refresh-token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "refresh-token"]
						}
					}
				}
			]
		},
		{
			"name": "2. Farmer Profile",
			"item": [
				{
					"name": "2.1 Profile - Main Tab",
					"request": {
