						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/profile?tab=main",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "profile"],
							"query": [{ "key": "tab", "value": "main" }]
						}
					}
				},
				{
					"name": "2.2 Profile - Personal Tab",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/profile?tab=personal",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "profile"],
							"query": [{ "key": "tab", "value": "personal" }]
						}
					}
				},
				{
