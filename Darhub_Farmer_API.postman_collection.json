						"url": {
							"raw": "{{baseUrl}}/api/farmer/profile?tab=farm",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "profile"],
							"query": [{ "key": "tab", "value": "farm" }]
						}
					}
				},
				{
					"name": "2.4 Profile - Address Tab",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/profile?tab=address",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "profile"],
							"query": [{ "key": "tab", "value": "address" }]
						}
					}
				},
				{
					"name": "2.5 Profile - Bank Tab",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/profile?tab=bank",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "profile"],
							"query": [{ "key": "tab", "value": "bank" }]
						}
					}
				},
				{
					"name": "2.6 Update Profile (Personal Tab)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"first_name\": \"Ramesh\",\n    \"last_name\": \"Patel\",\n    \"whatsapp_number\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/farmer/profile?tab=personal",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "profile"],
							"query": [{ "key": "tab", "value": "personal" }]
						}
					}
				}
			]
		},
		{
			"name": "3. Pre-Order & Crops",
			"item": [
				{
					"name": "3.1 Fetch Crops List",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.length > 0) {",
									"    pm.collectionVariables.set('cropTypeId', jsonData.data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/order/crops/list",
							"host": ["{{baseUrl}}"],
							"path": ["order", "crops", "list"]
						}
					}
				}
			]
		},
		{
			"name": "4. Order Creation",
			"item": [
				{
					"name": "4.1 Create Spraying Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.booking_id) {",
									"    pm.collectionVariables.set('bookingId', jsonData.booking_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"start_date\": \"2026-10-15\",\n    \"end_date\": \"2026-10-16\",\n    \"num_of_days\": 2,\n    \"crop_type_id\": {{cropTypeId}},\n    \"land_in_acers\": 7.5,\n    \"price\": 3750.00,\n    \"tax\": 187.50,\n    \"total_price\": 3937.50,\n    \"cupon_id\": 13,\n    \"discount\": 50.00,\n    \"user_id\": {{userId}},\n    \"farmer_details\": {\n        \"name\": \"Ramesh Patel\",\n        \"mobile\": \"9876543210\",\n        \"email\": \"ramesh.farmer@example.com\"\n    },\n    \"address\": {\n        \"state\": 1,\n        \"district\": 1,\n        \"block\": 1,\n        \"village\": \"Sonpur\",\n        \"lane1\": \"Plot 42\",\n        \"lane2\": \"East Sector\",\n        \"address1\": \"Plot 42\",\n        \"address2\": \"East Sector\",\n        \"pincode\": \"800001\"\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order/create-order",
							"host": ["{{baseUrl}}"],
							"path": ["order", "create-order"]
						}
					}
				}
			]
		},
		{
			"name": "5. Farmer Bookings & Orders",
			"item": [
				{
					"name": "5.1 Get Booking Status Tabs",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/bookings/statuses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "bookings", "statuses"]
						}
					}
				},
				{
					"name": "5.2 Get Farmer Bookings List (Cards)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/bookings?status=PENDING&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "bookings"],
							"query": [
								{ "key": "status", "value": "PENDING" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
							]
						}
					}
				},
				{
					"name": "5.3 Get Booking Detail by ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/bookings/{{bookingId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "bookings", "{{bookingId}}"]
						}
					}
				},
				{
					"name": "5.4 Reschedule Booking",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"new_date\": \"2026-10-25\",\n    \"new_time_window\": \"09:00 AM - 11:00 AM\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/farmer/bookings/{{bookingId}}/reschedule",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "bookings", "{{bookingId}}", "reschedule"]
						}
					}
				},
				{
					"name": "5.5 Cancel Booking",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cancellation_reason\": \"Heavy Monsoon Rain\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/farmer/bookings/{{bookingId}}/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "bookings", "{{bookingId}}", "cancel"]
						}
					}
				},
				{
					"name": "5.6 Rate Completed Booking",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rating\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/farmer/bookings/{{bookingId}}/rate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "farmer", "bookings", "{{bookingId}}", "rate"]
						}
					}
				}
			]
		},
		{
			"name": "6. Advanced Order Querying",
			"item": [
				{
					"name": "6.1 Filter Orders (Multi-Param Search)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"page\": 1,\n    \"pageSize\": 10,\n    \"orderBy\": \"created_on\",\n    \"orderType\": \"DESC\",\n    \"order_status\": \"ORDER_PLACED\",\n    \"is_paid\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/order/filter-orders",
							"host": ["{{baseUrl}}"],
							"path": ["order", "filter-orders"]
						}
					}
				},
				{
					"name": "6.2 Get Orders By User ID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{farmerToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/order/getOrderByUserId/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["order", "getOrderByUserId", "{{userId}}"]
						}
					}
				}
			]
		}
	]
}
