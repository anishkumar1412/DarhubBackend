// sequelize-cli layout:  npx sequelize-cli db:migrate | db:migrate:undo | db:migrate:status | db:seed:all ...
// The project is ESM ("type": "module"), so migrations and seeders are CommonJS files with a .cjs extension.
const path = require('path');

module.exports = {
  config: path.resolve(__dirname, 'config', 'sequelize-cli.cjs'),
  'migrations-path': path.resolve(__dirname, 'migrations'),
  'seeders-path': path.resolve(__dirname, 'seeders'),
  'models-path': path.resolve(__dirname, 'models'),
};
