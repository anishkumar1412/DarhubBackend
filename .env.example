# ── Database ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=drone_booking_management_dev
DB_PORT=5432
DB_DIALECT=postgres
# TLS to the database is on by default; set false only for a local database without TLS (e.g. tests).
# DB_SSL=false
# To run the server with another env file (e.g. a local test database): ENV_FILE=.env.test node server.js

# ── App ───────────────────────────────────────────────────────────
PORT=5678
NODE_ENV=development
# true = return OTPs in the send-otp response on a deployed server (Render: SMTP ports are blocked). Testing only.
# EXPOSE_OTP=true
# Keeps a Render free-tier instance awake by pinging it every 14 minutes. On Render this is automatic
# (RENDER_EXTERNAL_URL); set it only to ping a different address.
# SELF_PING_URL=https://darhubbackend.onrender.com

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
ADMIN_TOKEN_EXPIRY=8h

# ── Admin panel ────────────────────────────────────────────────────
ADMIN_PANEL_URL=http://localhost:3001
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_NAME=Super Admin
ADMIN_SETUP_EXPIRY_HOURS=24
ADMIN_RESET_EXPIRY_HOURS=1

# ── Email / SMTP ──────────────────────────────────────────────────
# Leave blank in development — links will be logged to the console instead
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=DARHUB Admin

# ── Cloudinary (existing) ─────────────────────────────────────────
CLOUD_SECRET=
CLOUD_KEY=
CLOUD_NAME=

# ── File storage: photos & documents ──────────────────────────────
# cloudinary (default, current) or s3. Full guide: docs/STORAGE_SETUP.md
STORAGE_PROVIDER=cloudinary
# --- s3 on your laptop with Floci (docker compose -f docker-compose.floci.yml up -d; npm run storage:init) ---
# STORAGE_PROVIDER=s3
# S3_BUCKET=darhub-uploads
# S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_PUBLIC_BASE_URL=http://<your-LAN-IP>:4566/darhub-uploads   # phones/emulators cannot reach "localhost"
# --- s3 in production (real AWS): no S3_ENDPOINT, prefer an IAM role (leave the keys empty) ---
# S3_BUCKET=darhub-prod-uploads
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com                  # CloudFront in front of the bucket

# SMTP_SECURE defaults to true only for port 465. Gmail: port 587 + a 16-character App Password.
# NOTE: Render's free tier blocks outbound SMTP (25/465/587); use a paid instance or an email-API provider there.
# SMTP_SECURE=false
# EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_FROM_NAME=DARHUB Admin

# ── HTTP / platform (all optional) ───────────────────────────────
# Number of reverse proxies in front of the app (Render, nginx, load balancer = 1). Needed for per-client rate limits.
TRUST_PROXY=1
# Requests per signed-in user (or IP) per 15 minutes for the whole API
RATE_LIMIT_MAX=1000
# Extra browser origins allowed by CORS, comma separated
# CORS_ORIGINS=https://admin.example.com
# The database schema is created and changed ONLY by migrations: `npm run db:migrate` (docs/DATABASE.md).
# A production start with migrations pending is refused (SKIP_MIGRATION_CHECK=true overrides, for emergencies only).
# Throwaway databases (tests) can still build tables from the models on boot: DB_SYNC=true, and DB_SYNC_ALTER=true to
# also rewrite a few tables. Both default to false and must never be set against a real database.
# DB_SYNC=false
# DB_SYNC_ALTER=false
# SKIP_MIGRATION_CHECK=false

# ── OTP / SMS ────────────────────────────────────────────────────
# NODE_ENV=development  -> the generated OTPs are returned in the send-otp response (and printed in the log), so you
#                          can sign up with no mailbox or SMS gateway. Never run a public server like this.
# NODE_ENV=production   -> OTPs are only delivered: email through SMTP, mobile through the SMS gateway. They never
#                          appear in a response.
# SMS gateway: 'console' prints mobile OTPs in the server log (default outside production); 'none' = no gateway
# connected (default in production). With 'none', a farmer who gave an e-mail verifies by e-mail only, and mobile-only
# sign-up is unavailable until a gateway is plugged into services/sms.service.js.
# SMS_PROVIDER=console
# GST rate added to bookings made in the Farmer app (the server calculates the price)
# ORDER_TAX_RATE=0.05

# ── SMS through your own Android phone (TextBee, https://textbee.dev) ─────────
# 1. Sign up at textbee.dev and install the TextBee Android app on the phone whose SIM will send the SMS.
# 2. Dashboard -> Register Device -> scan the QR code with the app. Keep the phone online with the app running.
# 3. Dashboard -> API Keys -> create a key and paste it below. Free plan: 1 device, 50 SMS a day, 300 a month.
# SMS_PROVIDER=textbee
# TEXTBEE_API_KEY=your_textbee_api_key
# TEXTBEE_DEVICE_ID=            only if several phones are registered; leave empty to use the default device
# TEXTBEE_BASE_URL=https://api.textbee.dev
# TEXTBEE_TIMEOUT_MS=10000
# SMS_DEFAULT_COUNTRY_CODE=+91  added to 10-digit mobile numbers

# ── OTP limits (all optional; these are the defaults) ─────────────
# OTP_EXPIRY_SECONDS=180            how long a code is valid
# OTP_RESEND_COOLDOWN_SECONDS=30    wait before "Resend"; the apps show this exact countdown
# OTP_SEND_WINDOW_MINUTES=15        window for the two send limits
# OTP_MAX_SENDS_PER_IP=5            codes one network may request per window
# OTP_MAX_SENDS_PER_TARGET=5        codes one phone number / email may receive per window
# OTP_MAX_VERIFY_ATTEMPTS=3         wrong tries per code (then a new code is needed)
# OTP_MAX_FAILED_VERIFIES=10        wrong tries per phone/email per window before it is blocked
# OTP_BLOCK_MINUTES=15              length of that block
# Redis keeps these counters shared across server instances (without it they live in memory per instance).
# Setup for local development and production: docs/REDIS.md
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_PREFIX=darhub:development:

# ── Push notifications (FCM) ── see docs/PUSH_NOTIFICATIONS.md
# console = print what would be sent (development) | fcm = send through Firebase | none = inbox only, no pushes.
# Default: console in development; in production fcm when a key below is set, otherwise none.
# NOTIFICATION_PROVIDER=console
# Firebase service-account key (Firebase console -> Project settings -> Service accounts -> Generate new private key).
# The JSON itself, or the same JSON base64-encoded; OR a file path. It is a SECRET: never commit it.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=
# NOTIFICATION_WORKER_ENABLED=true
# NOTIFICATION_POLL_SECONDS=10
# NOTIFICATION_BATCH_SIZE=200
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_RETENTION_DAYS=90
