{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.integration.test.js",
    "storage:init": "node scripts/init-storage.js",
    "audit:data": "node scripts/audit-data.js",
    "db:integrity": "node scripts/apply-integrity.js",
    "test:e2e": "bash tests/e2e/run.sh",
    "check:locations": "node scripts/check-location-matching.js ./lgd-data",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:demo": "sequelize-cli db:seed:all --seeders-path seeders/demo",
    "db:seed:locations": "node scripts/download-lgd.js ./lgd-data && node scripts/import-lgd.js ./lgd-data --apply",
    "db:check": "node scripts/check-schema.js",
    "db:setup:local": "docker compose -f docker-compose.local-db.yml up -d --wait && npm run db:migrate && npm run db:seed",
    "db:reset:local": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "db:rehearse": "bash scripts/rehearse-migrations.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
