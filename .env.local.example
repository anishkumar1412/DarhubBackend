# Local development against the Docker database from docker-compose.local-db.yml.
# Use it with:  cp .env.local.example .env.local   then   ENV_FILE=.env.local npm run dev   (db:* scripts load it by default)
DB_HOST=127.0.0.1
DB_PORT=55433
DB_USER=darhub
DB_PASSWORD=darhub_local_pw
DB_NAME=darhub_local
DB_DIALECT=postgres
DB_SSL=false

PORT=5678
NODE_ENV=development
JWT_SECRET=local-dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789
ADMIN_TOKEN_EXPIRY=8h
ADMIN_PANEL_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_NAME=Super Admin
SMS_PROVIDER=console
TRUST_PROXY=1

# ── Push notifications (FCM) ── see docs/PUSH_NOTIFICATIONS.md
# console = print what would be sent (development) | fcm = send through Firebase | none = inbox only, no pushes.
# Default: console in development; in production fcm when a key below is set, otherwise none.
# NOTIFICATION_PROVIDER=console
# Firebase service-account key (Firebase console -> Project settings -> Service accounts -> Generate new private key).
# The JSON itself, or the same JSON base64-encoded; OR a file path. It is a SECRET: never commit it.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=
# NOTIFICATION_WORKER_ENABLED=true
# NOTIFICATION_POLL_SECONDS=10
# NOTIFICATION_BATCH_SIZE=200
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_RETENTION_DAYS=90
